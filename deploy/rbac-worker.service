# rbac-worker.service — always-on Worker Node for the Control Illusion Benchmark.
#
# Runs start_worker.sh under systemd so the worker:
#   • survives the terminal / SSH session closing,
#   • restarts automatically if it crashes,
#   • starts on boot.
#
# INSTALL
#   1. Edit User=, Group=, and WorkingDirectory= below to match this machine
#      (WorkingDirectory is just the folder that contains start_worker.sh — the
#      script is self-contained, so no repository checkout is required there).
#   2. sudo cp deploy/rbac-worker.service /etc/systemd/system/
#   3. sudo systemctl daemon-reload
#   4. sudo systemctl enable --now rbac-worker
#
# Logs:   journalctl -u rbac-worker -f
# Stop:   sudo systemctl stop rbac-worker
#
# Note: systemd already supervises the process, so start_worker.sh is invoked in
# foreground mode (NOT --daemon); its own Ollama/listener restart loops still apply
# and complement systemd's Restart=.

[Unit]
Description=RBAC Benchmark Worker Node (Ollama + UDP discovery/heartbeat)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# --- EDIT THESE for the target machine ---
User=vini
Group=vini
WorkingDirectory=/home/vini/Projects/LLM-tool-injection-Benchmark
# -----------------------------------------
# Match the Master's config if you override defaults:
Environment=RBAC_UDP_PORT=5005
Environment=RBAC_HEARTBEAT_INTERVAL=10
ExecStart=/bin/bash start_worker.sh
Restart=always
RestartSec=3
KillMode=mixed
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
